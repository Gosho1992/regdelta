{
  "framework": "PRF",
  "framework_name": "Prudential Reporting Framework (fictional)",
  "version": "3.2",
  "authority": "FRSA - Fictional Regulatory Supervisory Authority",
  "effective_date": "2027-01-01",
  "templates": [
    {"code": "L01", "name": "Loan-level exposures"},
    {"code": "C02", "name": "Counterparty register"}
  ],
  "fields": [
    {"dpm_id": "dp-1001", "code": "REPORTING_DATE", "templates": ["L01", "C02"], "type": "date", "format": "YYYY-MM-DD", "mandatory": true,
     "definition": "Reference date of the reported figures.", "section": "PRF 3.2 s.2.1"},
    {"dpm_id": "dp-1010", "code": "LOAN_ID", "templates": ["L01"], "type": "string(32)", "format": null, "mandatory": true,
     "definition": "Unique identifier of the loan within the reporting entity.", "section": "PRF 3.2 s.3.1"},
    {"dpm_id": "dp-1011", "code": "COUNTERPARTY_ID", "templates": ["L01", "C02"], "type": "string(32)", "format": null, "mandatory": true,
     "definition": "Identifier of the counterparty, consistent across templates.", "section": "PRF 3.2 s.3.2"},
    {"dpm_id": "dp-1020", "code": "EXPOSURE_AMOUNT", "templates": ["L01"], "type": "decimal(18,2)", "format": null, "mandatory": true,
     "definition": "Carrying amount of the exposure net of specific credit risk provisions.", "section": "PRF 3.2 s.3.4"},
    {"dpm_id": "dp-1021", "code": "PROVISION_AMOUNT", "templates": ["L01"], "type": "decimal(18,2)", "format": null, "mandatory": true,
     "definition": "Specific credit risk provisions held against the exposure.", "section": "PRF 3.2 s.3.5"},
    {"dpm_id": "dp-1030", "code": "COUNTERPARTY_SECTOR", "templates": ["C02"], "type": "enum", "format": null, "mandatory": true,
     "definition": "Institutional sector of the counterparty.", "section": "PRF 3.2 s.4.2"},
    {"dpm_id": "dp-1031", "code": "COUNTRY_CODE", "templates": ["C02"], "type": "string(2)", "format": "ISO 3166-1 alpha-2", "mandatory": true,
     "definition": "Country of residence of the counterparty.", "section": "PRF 3.2 s.4.3"},
    {"dpm_id": "dp-1032", "code": "LEI_CODE", "templates": ["C02"], "type": "string(20)", "format": "ISO 17442", "mandatory": true,
     "definition": "Legal entity identifier of the counterparty (ISO 17442).", "section": "PRF 3.2 s.4.4"}
  ],
  "validation_rules": [
    {"id": "VR-101", "templates": ["L01"], "severity": "error", "expression": "EXPOSURE_AMOUNT >= 0", "section": "PRF 3.2 Annex V"},
    {"id": "VR-114", "templates": ["L01", "C02"], "severity": "error", "expression": "Every L01.COUNTERPARTY_ID must exist in C02.COUNTERPARTY_ID for the same REPORTING_DATE", "section": "PRF 3.2 Annex V"},
    {"id": "VR-120", "templates": ["C02"], "severity": "error", "expression": "LEI_CODE matches ^[A-Z0-9]{18}[0-9]{2}$", "section": "PRF 3.2 Annex V"}
  ]
}
